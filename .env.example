# Environment Configuration for CodeNoSekai Platform
NODE_ENV="development"
PORT=3000

# Admin Portal Credentials (Server-side only)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your_strong_admin_password_here"
SESSION_SECRET="your_long_random_session_secret_key"

# Database (MongoDB Atlas or Local MongoDB)
# If left empty, an automatic in-memory fallback is used during development
MONGODB_URI="mongodb://127.0.0.1:27017/codenosekai"

# GitHub Token for enhanced rate limits when fetching organization data (Optional)
GITHUB_TOKEN=""
